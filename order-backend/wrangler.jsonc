
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gms-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "gms-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "Backend"
      }
    ]
  },
  "triggers": {
    "crons": ["30 3 * * *"]
  },
  "vars": {
    "PRODUCTION_DOMAIN": "https://gms.globalmarketingsolutions.in",
    "WORKER_URL": "https://gms-api.gms-website.workers.dev"
  }
}
