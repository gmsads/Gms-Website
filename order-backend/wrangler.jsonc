{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gms-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "vars": {
    "WORKER_URL": "https://gms-api.gms-website.workers.dev",
    "PRODUCTION_DOMAIN": "https://gms.globalmarketingsolutions.in"
  },
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Backend",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "gms-uploads" }],
  "triggers": { "crons": ["30 3 * * *"] }
}
